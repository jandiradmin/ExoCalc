{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ExoCalc",
  "version": "1.3.3",
  "identifier": "com.jandiradmin.exocalc",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ExoCalc",
        "width": 760,
        "height": 600,
        "minWidth": 360,
        "minHeight": 220,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#202124",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Yan Hordashevskyy",
    "copyright": "© 2026 Yan Hordashevskyy",
    "category": "Utility",
    "shortDescription": "Notepad calculator with currencies and units",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5OTZFODQ5MTYxNEU4MTkKUldRWjZCUVdTZWlXYVdzbncyUUt1b0thSHY2UEtwdXltS1ZhT1cxTEYwU2QxVXEycThHa1hHRXAK",
      "endpoints": [
        "https://github.com/jandiradmin/ExoCalc/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
